NALMAI_DATABASE_PATH=./data/nalmai.sqlite3
NALMAI_FERNET_KEY=
NALMAI_HMAC_KEY=
NALMAI_INTERNAL_API_TOKEN=
NALMAI_ALLOW_GROUP_SECRETS=false
NALMAI_HTTP_TIMEOUT_SECONDS=15
NALMAI_B50_OUTPUT_DIR=./data
NALMAI_SHARED_ASSET_DIR=./data/shared-assets

# 机台成绩读取默认关闭。安装 arcade 可选依赖后，将 unavailable 改为 maimai_py。
# 代理仅在你的网络确实需要时填写完整 HTTP 代理地址，否则保持空值。
NALMAI_ARCADE_PROVIDER=unavailable
NALMAI_ARCADE_HTTP_PROXY=
NALMAI_LOCAL_API_PORT=8000

# 面向群友开放时的资源保护：高消耗指令按“用户+指令”冷却，超过全局并发上限时立即提示稍后重试。
NALMAI_QQ_EXPENSIVE_COOLDOWN_SECONDS=30
NALMAI_QQ_MAX_CONCURRENT_EXPENSIVE=2

# QQ 官方 WebSocket。只填本机 .env，不要把 AppSecret 发到聊天或提交 Git。
# 当前锁定 nonebot-adapter-qq 1.7.2。token 是适配器必需的兼容字段，必须保留为空字符串；
# QQ 鉴权只填写 AppID 与 AppSecret。
# 只订阅私聊和群聊 @ 消息；其他 intent 明确关闭。
QQ_BOTS=[{"id":"在此填写AppID","token":"","secret":"在此填写AppSecret","intent":{"guilds":false,"guild_members":false,"guild_messages":false,"guild_message_reactions":false,"direct_message":false,"open_forum_event":false,"audio_live_member":false,"group_members":false,"c2c_group_at_messages":true,"interaction":false,"message_audit":false,"forum_event":false,"audio_action":false,"at_messages":false},"use_websocket":true}]

# 事件采集默认只写脱敏副本。只有 /status 测试消息允许写原始事件，
# 且必须显式把 NALMAI_QQ_CAPTURE_RAW 改为 true。
NALMAI_QQ_CAPTURE_ENABLED=true
NALMAI_QQ_CAPTURE_RAW=false
NALMAI_QQ_CAPTURE_DIR=./data/qq-events

# 已按真实脱敏事件固定映射：私聊 author.user_openid；群聊
# group_openid + author.member_openid。跨场景身份通过一次性 /pair 码显式关联，
# 不使用当前为空的 union_openid，也不猜测两种 OpenID 的对应关系。
